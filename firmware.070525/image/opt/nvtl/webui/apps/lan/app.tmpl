<tmpl_if isHidden>
	<div class="notification app error">
		<i class="icon-error"></i>
		<tmpl_var _("webui", "webui_app_hidden_text")>
	</div>
<tmpl_else>
<script type="text/javascript">
	/* <![CDATA[ */
	var validated = false;
	var lanSettingsChanged = false;
	var ipptSettingsChanged = false;
	var ipv6SettingsChanged = false;
	var showTurnOffWiFi = "<tmpl_var showTurnOffWiFiIPPTOn>";
	var reboot_device = false;
	var isPopupExists = false;
	var ethWanActive = "<tmpl_var ethWanActive>";

	$(function()
	{
		if ("<tmpl_var reboot>" === "true") {
			window.location = "<tmpl_udf GET_URI('restarting')>";
		}

		<tmpl_if showAutoPopulateClientOption>
                        <tmpl_if showIPPTInterface>
                                toggleClientInterfaceFields();

                                $("#hostIDAutoSelect").on("click", function() {
                                        toggleClientInterfaceFields();
                                });
                        </tmpl_if>
                </tmpl_if>

		checkForDHCPDisabled();
		checkForIPPTDisabled();

		if(ethWanActive == "1") {
			$("#isIpPassthroughActive").prop("disabled", true);
			$("#ipPassthroughInterface").prop("disabled", true);
                        if($("#ipPassthroughInterface").val() == 1) {
                                $("#hostName").prop("disabled", true);
                        } else {
                                $("#hostMACAddress").prop("disabled", true);
                        }
			
			$("#ipptEthWanActiveNote").show();
		} else {
			$("#isIpPassthroughActive").prop("disabled", false);
                       	if($("#isIpPassthroughActive").is(":checked")) {
                                $("#ipPassthroughInterface").prop("disabled", false);
                                if($("#ipPassthroughInterface").val() == 1) {
                                        $("#hostName").prop("disabled", false);
                                } else {
                                        $("#hostMACAddress").prop("disabled", false);
                                }
                        } else {
                                $("#ipPassthroughInterface").prop("disabled", true);
                                if($("#ipPassthroughInterface").val() == 1) {
                                        $("#hostName").prop("disabled", true);
                                } else {
                                        $("#hostMACAddress").prop("disabled", true);
                                }
                        }
			$("#ipptEthWanActiveNote").hide();
		}

		$("#isIpPassthroughActive").click(function() {
			if(($("#isIpPassthroughActive").is(":checked")) && showTurnOffWiFi) {
				showWarningMessage("<tmpl_var _('webui', 'lan_interfaces_warning_text')>");
			} else {
				checkForIPPTDisabled();
			}
		});

		function showWarningMessage(text) {                                 
            		modalPopup.createWindow('<tmpl_var _("webui", "webui_app_warning_title")>', '<p>'+text+'</p>', 430, 250, [{
                		text : '<tmpl_var _("webui", "webui_modal_ok_button")>',                      
                		className : "primary",
                		trigger : function() {                             
                    			// do nothing
		    			checkForIPPTDisabled();
                		}                                                
            		}], null, function() {                                 
                		// do nothing                                              
            		});                                                          
        	}

		$("#dhcpServerEnable").on("change", function() {
			if ($(this).is(":checked")) {
				$("#sample").html("");
				$("#dhcpRangeBegin").prop("disabled", false);
				<tmpl_if showDHCPEndAddressEditOption>
				    $("#dhcpRangeEnd").prop("disabled", false);
				</tmpl_if>
				$("#dhcpServerLeaseTime").prop("disabled", false);
				$("#reservedIP").prop("disabled", false);
			} else {
				$("#dhcpRangeBegin").prop("disabled", true);
				<tmpl_if showDHCPEndAddressEditOption>
				    $("#dhcpRangeEnd").prop("disabled", true);
				</tmpl_if>
				$("#dhcpServerLeaseTime").prop("disabled", true);
				$("#reservedIP").prop("disabled", true);

				$("#sample").html('<tmpl_var _("webui", "adv_lan_dhcp_server_enabled_help_text")>');
				if (jQuery.uniform) $.uniform.update("#sample");
			}
			<tmpl_if LANReservedIPAddressShow>
				<tmpl_if LANReservedIPAddressLocked>
					$("#reservedIP").prop("disabled", true);
				</tmpl_if>
			</tmpl_if>
		});

		<tmpl_if showDHCPEndAddressEditOption>
		$("#dhcpRangeBegin, #dhcpRangeEnd").on("change", function() {
		<tmpl_else>
		$("#dhcpRangeBegin").on("change", function() {
		</tmpl_if>
			<tmpl_if LANReservedIPAddressShow>
				if("<tmpl_var reserveIpCount>" != "0") {
					modalPopup.createWindow('<tmpl_var _("webui", "webui_app_warning_title")>', '<p><tmpl_var _("webui", "adv_lan_save_changes_confirm_modal_with_reservedip_text")></p>', 530, "auto", [{
						text : '<tmpl_var _("webui", "webui_modal_ok_button")>',                                                         
						className : "primary",                                                                                        
						trigger : function(){ 
						}                                                                                                          
					}], null, function(){
					});
				}
   			</tmpl_if>
		});

		$("#adv_lan_form").on("submit", function(e) {
			return (validated) ? true : validate();
		});

		<tmpl_if LANReservedIPAddressShow>
			<tmpl_unless LANReservedIPAddressLocked>
				$("#reservedIP").click(function() {
					window.location.href = "<tmpl_udf GET_URI('reserved_ip')>";
				});
			</tmpl_unless>
		</tmpl_if>

		function validate()
		{
			$(".notification_inner").parent().remove();
			$("span.form-error").remove();
			$("#adv_lan_form").find(".inline_error").remove();
			var valid = true;
			var ipEl = $("#ipAddress");
			var subnetEl = $("#subnetMask");
			var dhcpEl = $("#dhcpRangeBegin");			
			var isIpv6Active = $("#ipv6Active").is(":checked");
			var dhcpEnabled = $("#dhcpServerEnable").is(":checked");
			var dhcpleasetimeEl = $("#dhcpServerLeaseTime");
			var ipaddress = ipEl.val();
			var subnet = subnetEl.val();
			var dhcp = dhcpEl.val();
			var dhcpleasetime = dhcpleasetimeEl.val();
			var ipptEnabled = $("#isIpPassthroughActive").is(":checked");
			var ipptInterface = $("#ipPassthroughInterface").val();
			var ethernetPortEnabled = "<tmpl_var ethernetPortEnabled>";
			<tmpl_if showAutoPopulateClientOption>
				var hostIDAutoSelect = $("#hostIDAutoSelect").is(":checked");
			</tmpl_if>

			if(ipptInterface == 1) {
				var hostName = $("#hostName").val();
			} else if(ipptInterface == 2 || ipptInterface == 4) {
				var hostMACAddress = $("#hostMACAddress").val();
			}

			<tmpl_if showDHCPEndAddressEditOption>
				var dhcpEndEl = $("#dhcpRangeEnd");
				var dhcpEnd = dhcpEndEl.val();
			</tmpl_if>
			
			<tmpl_if showIPPTInterface>
				if($("#isIpPassthroughActive").is(":checked")) {
				
					<tmpl_if showIPPTInterfaceOptions>
						if((ipptInterface == 2 || ipptInterface == 4) && (ethernetPortEnabled === "off"))
						{
							showWarning("<tmpl_var _("webui", "ippt_ethernet_off_warning_text")>");
							valid = false;
						}
					</tmpl_if>
					if($("#hostMACAddress").is(":visible")) {
						var macEl = $("#hostMACAddress");
						var macError = validateMacAddress(macEl);
						if(macError !== "") {
							valid = false;
							appendErrorMessage(macEl.closest("div.form-group"), macError);
						}
					}
			
					if($("#hostName").is(":visible")) {	
						var hostNamePatt = /^[\w\-\_\.]+$/;
						var hostnamematch = hostName.match(hostNamePatt);
						if (hostnamematch == null) {
							appendErrorMessage($("#hostName").closest("div.form-group"), '<tmpl_var _("webui", "adv_lan_ip_passthrough_hostname_invalid_error_text")>')                                
							valid = false;
						}
					}
				}
			</tmpl_if>			
	
			<tmpl_if validateIpRangeAndSubnet>
				var patt = /^(10\.(([0-1][0-9][0-9])|([2][0-4][0-9])|([2][5][0-5])|([0-9][0-9])|([0-9]))|172\.(3[01]|2[0-9]|1[6-9])|192\.168)\.(([0-1][0-9][0-9])|([2][0-4][0-9])|([2][5][0-5])|([0-9][0-9])|([0-9]))\.(([0-1][0-9][0-9])|([2][0-4][0-9])|([2][5][0-5])|([0-9][0-9])|([0-9]))$/;
				var dhcpPatt = /^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/;
				var subnetpatt = /^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$/;

				var ipmatch = ipaddress.match(patt);
				var subnetmatch = subnet.match(subnetpatt);

				if (ipmatch == null) {
					appendErrorMessage(ipEl.closest("div.form-group"), '<tmpl_var _("webui", "adv_lan_invalid_ip_address_error_text")>');
					valid = false;
				}

				if(subnetmatch == null) {
					appendErrorMessage(subnetEl.closest("div.form-group"), '<tmpl_var _("webui", "adv_lan_blank_subnet_mask_address_error_text")>');
					valid = false;
				}
				else {
					if (subnet === "255.0.0.0" || subnet === "255.255.0.0" || subnet === "255.255.255.0") {
					// Subnet is valid
					} else {
						appendErrorMessage(subnetEl.closest("div.form-group"), '<tmpl_var _("webui", "adv_lan_supported_subnets_error_text")>');
						valid = false;
					}
				}

				if (dhcpEnabled) {
					var dhcpmatch = dhcp.match(dhcpPatt);
					if (dhcpmatch == null) {
						appendErrorMessage(dhcpEl.closest("div.form-group"), '<tmpl_var _("webui", "adv_lan_blank_dhcp_begin_address_error_text")>');
						valid = false;
					}
					<tmpl_if showDHCPEndAddressEditOption>
						dhcpmatch = dhcpEnd.match(dhcpPatt);
						if (dhcpmatch == null) {
							appendErrorMessage(dhcpEndEl.closest("div.form-group"), '<tmpl_var _("webui", "adv_lan_blank_dhcp_end_address_error_text")>');
							valid = false;
						}
					</tmpl_if>
				}
			</tmpl_if>

			if (valid) {
				var dhcpValue = "off";
				if(dhcpEnabled) {
					dhcpValue = "on";
				} else {
					dhcpValue = "off";
				}
				var ipv6Value = "off";
				if(isIpv6Active) {
					ipv6Value = "on";
				}	
				var ipptValue = "off";
				if(ipptEnabled) {
					ipptValue = "on";
				}

				<tmpl_if showAutoPopulateClientOption>
					var hostIDAutoValue = "off";
					if(hostIDAutoSelect) {
						hostIDAutoValue = "on";
					}
				</tmpl_if>
	
				if (ipaddress !== "<tmpl_var ipAddress>" || subnet !== "<tmpl_var subnetMask>" || dhcp !== "<tmpl_var dhcpRangeBegin>" || dhcpleasetime != "<tmpl_var dhcpServerLeaseTime>" || 
				<tmpl_if showDHCPEndAddressEditOption> dhcpEnd !== "<tmpl_var dhcpRangeEnd>" || </tmpl_if> dhcpValue != "<tmpl_var dhcpServerEnable>") {
					lanSettingsChanged = true;	
				}

				if((ipptValue != "<tmpl_var isIpPassthroughActive>") || 
				   	(ipptInterface != "<tmpl_var ipPassthroughInterface>") || 
					<tmpl_if showAutoPopulateClientOption>
					(hostIDAutoValue != "<tmpl_var hostIDAutoSelect>") ||
					(!hostIDAutoSelect && ((ipptInterface == 1 && hostName != "<tmpl_var hostName>") || 
					(((ipptInterface == 2 || ipptInterface == 4) && hostMACAddress != "<tmpl_var hostMACAddress>"))))) { 
					<tmpl_else>
						(ipptInterface == 1 && hostName != "<tmpl_var hostName>") || 
						(((ipptInterface == 2 || ipptInterface == 4) && hostMACAddress != "<tmpl_var hostMACAddress>"))) {
					</tmpl_if>
					ipptSettingsChanged = true;
				}

				if(("<tmpl_var ipv6Supported>" == "1") && (ipv6Value != "<tmpl_var ipv6Active>")) {
					ipv6SettingsChanged = true;
				}

				if(lanSettingsChanged || ipptSettingsChanged || ipv6SettingsChanged) {
					if(lanSettingsChanged) {
						showPopupScreen();
					<tmpl_if rebootForIPPTChange>
					} else if(ipptSettingsChanged) {
						showPopupScreen();
					</tmpl_if>
					} else {
						if (!ipptSettingsChanged) {
							validated = true;
							$("#adv_lan_form").submit();
						}
						else {
							validated = false;
							if (ipptEnabled) {
								waitTime = 60000;
							}
							else {
								waitTime = 40000;
							}
							checkServerAliveStatus(waitTime);
							$("#adv_lan_form").submit(doAsyncSubmit());
						}
					}
				}

				return false;
			} else {
				return false;
			}
		}

		function showPopupScreen() {
			modalPopup.createWindow(
				'<tmpl_var _("webui", "webui_modal_confirm_button")>',
				'<p><tmpl_udf GET_PO_TEXT("adv_lan_save_changes_confirm_modal_without_reservedip_text", gProductName)></p>',
				430, 250,
				[
					{
						text : '<tmpl_var _("webui", "webui_modal_confirm_button")>',
						className : "primary",
						trigger : function() {
							if (!ipptSettingsChanged) {
								validated = true;
								$("#adv_lan_form").submit();
							}
							else {
								<tmpl_unless rebootForIPPTChange>
									validated = false;
									checkServerAliveStatus(40000);
									reboot_device = true;
									$("#adv_lan_form").submit(doAsyncSubmit());
								<tmpl_else>
									validated = true;
									$("#adv_lan_form").submit();
								</tmpl_unless>
							}
						}
					},
					{
						text : '<tmpl_var _("webui", "webui_modal_cancel_button")>',
						className : "cancel",
						trigger : function() {
							validated = false;
						}
					}
				],
				null,
				function() {
					validated = false;
				}
			);
		}

		function validateMacAddress(macEl)
		{
			var errors = "";
			var inputVal = macEl.val();

			if( (inputVal.length == 0) ) {
				errors = '<tmpl_var _("webui", "adv_lan_mac_addr_invalid_error_text")>';
			} else if( !containsPrintable(inputVal) ) {
				errors= '<tmpl_var _("webui", "adv_lan_mac_addr_invalid_error_text")>';
			} else if( !isValidMacAddress(inputVal) ) {
				errors = '<tmpl_var _("webui", "adv_lan_mac_addr_invalid_error_text")>';
			} else {
				inputVal = inputVal.replace(new RegExp("-","g"),":");
				macEl.val(inputVal);
			}

			return errors;
		}

		/**
		 * containsPrintable()
		 *
		 * str: string - unicode string to test
		 *
		 * returns boolean
		 *
		 * Test if string contains printable characters and no control characters.
		 */
		function containsPrintable(str)
		{
			return /^[a-zA-Z0-9!"#$%&'()*+,.\/:;<=>?@\[\] ^_`{|}~-]*$/.test(str);
		}
		
		function successWindow()
		{
			var title = null;
    			var content = "<div id='lanSpinnerTable'></div>";
    			var width = 450;
    			var height = 300;
    			var btns = null;
    			var close = null;
				var closeOnEsc = false;

    			var open = function() {
				$(".ui-dialog-titlebar-close").hide();
    				$("#lanSpinnerTable").append("<div id='lanSpinnerTableInner'></div>");

				var tableRow = $("<div id='lanSpinner'>");

				tableRow.append(
					"<div class='row'>" +
    					"<div class='ig_icn_lg ig_success'></div>" +
    					"<p><tmpl_var _('webui', 'webui_save_code_success_text')></p>" +
    					"</div>" +
    					"<button type='button' id='successOkButton' class='primary' onclick='window.location.reload();'>" +
						"<tmpl_var _('webui', 'webui_modal_ok_button')>" +
					"</button>"
				);

				tableRow.append("</div>");

				$("#lanSpinnerTableInner").append(tableRow);
		   	};
    		modalPopup.createWindow(title, content, width, height, btns, open, close, closeOnEsc);
		}

		function failureWindow()
		{
			var title = null;
			var content = "<div id='lanSpinnerTable'></div>";
			var width = 450;
			var height = 300;
			var btns = null;
			var close = null;
			var closeOnEsc = false;

			var open = function() {
			$(".ui-dialog-titlebar-close").hide();
				$("#lanSpinnerTable").append("<div id='lanSpinnerTableInner'></div>");

				var tableRow = $("<div id='lanSpinner'>");

				tableRow.append(
						"<div class='row'>" +
						"<div class='ig_icn_lg ig_failure'></div>" +
						"<p><tmpl_var _('webui', 'adv_reserved_id_ping_server_failure_text')></p>" +
						"</div>" +
						"<button type='button' id='failureOkButton' class='primary' onclick='window.location.reload();'>" +
								"<tmpl_var _('webui', 'webui_modal_ok_button')>" +
						"</button>"
				);

				tableRow.append("</div>");

				$("#lanSpinnerTableInner").append(tableRow);
			};
			modalPopup.createWindow(title, content, width, height, btns, open, close, closeOnEsc);
		}

		function pingServer() {
			$.ajax({
				type: "GET",
				url: "/lan/",
				dataType : "json",
				success: function () {
						if (isPopupExists) {
							isPopupExists = false;
							modalPopup.destroyWindow();
						}
						if (ipptSettingsChanged && lanSettingsChanged && reboot_device) {
							window.location = "<tmpl_udf GET_URI('restarting')>";
							reboot_device = false;
						}
						else if (ipptSettingsChanged) {
							successWindow();
						}
				},
				error: function(xhr) {
					if ((xhr.readyState == 4 ) && (xhr.status == 200)) {
						if (isPopupExists) {
							isPopupExists = false;
							modalPopup.destroyWindow();
						}
						if (ipptSettingsChanged && lanSettingsChanged && reboot_device) {
							window.location = "<tmpl_udf GET_URI('restarting')>";
							reboot_device = false;
						}
						else if (ipptSettingsChanged) {
							successWindow();
						}
					}
					if (isPopupExists) {
						setTimeout(pingServer, 2000);
					}
				}
			})
		}

		function checkServerAliveStatus(waitTime)
		{
			var title = null;
			var content = "<div id='lanSpinnerTable'></div>";
			var width = 450;
			var height = 300;
			var btns = null;
			var close = null;
			var closeOnEsc = false;

			var open = function() {
				$(".ui-dialog-titlebar-close").hide();
				$("#lanSpinnerTable").append("<div id='lanSpinnerTableInner'></div>");
				isPopupExists = true;
				var tableRow = $("<div id='lanSpinner'>");

				tableRow.append(
					"<div class='row'>" +
						"<div class='ig_icn_lg ig_loading'></div>" +
						"<p><tmpl_var _('webui', 'adv_lan_save_changes_spinner_text')></p>" +
						"</div>"
				);
				tableRow.append("</div>");

				$("#lanSpinnerTableInner").append(tableRow);

				setTimeout(function() {
					if(isPopupExists) {
						isPopupExists = false;
						modalPopup.destroyWindow();
						failureWindow();
						$.statusBar("start");
						notifications.startPolling();
					}
				}, 80000);
			};

			modalPopup.createWindow(title, content, width, height, btns, open, close, closeOnEsc);
			setTimeout(pingServer, waitTime);
		}

		function doAsyncSubmit()
		{
			$.statusBar("stop");
			notifications.stopPolling();
			var form = $("#adv_lan_form");
			var url = "<tmpl_udf GET_URI('lan_save_changes')>";
			$.ajax({
				type: "POST",
				url: url,
				data: form.serialize(), // serializes the form's elements.
				dataType : "json",
				success: function(data, textStatus, xhr)
				{
					if (data.reboot == "true") {
						reboot_device = true;
					}
				},
				error: function(xhr, textStatus, errorThrown)
				{
					var obj = jQuery.parseJSON(xhr.responseText || "null");
					if (obj != null && obj.errorCount == 0) {
						if (obj.reboot == "true") {
							reboot_device = true;
						}
					}
					// server validation error handling
					if (obj != null && obj.errorCount > 0) {
						reboot_device = false;
						ipptSettingsChanged = false;
						if (isPopupExists) {
							 isPopupExists = false;
							 modalPopup.destroyWindow();
						}
						handleValidationErrors(obj);
					}
				},
				complete: function(xhr)
				{
				}
			});
		}

		function handleValidationErrors(obj)
		{
			var ipEl = $("#ipAddress");
			var subnetEl = $("#subnetMask");
			var dhcpEl = $("#dhcpRangeBegin");
			var dhcpleasetimeEl = $("#dhcpServerLeaseTime");
			var macEl = $("#hostMACAddress");
			var hostnameEl = $("#hostName");
			var gatewayEl = $("#gatewaySection");

			<tmpl_if showDHCPEndAddressEditOption>
				var dhcpEndEl = $("#dhcpRangeEnd");
			</tmpl_if>

			if (obj.ipAddressError != undefined) {
				ipEl.addClass("error");
				appendErrorMessage(ipEl.closest("div.form-group"), obj.ipAddressError)
			}
			if (obj.hostMACAddressError != undefined) {
				macEl.addClass("error");
				appendErrorMessage(macEl.closest("div.form-group"), obj.hostMACAddressError);
			}
			if (obj.hostNameError != undefined) {
				hostnameEl.addClass("error");
				appendErrorMessage(hostnameEl.closest("div.form-group"), obj.hostNameError);
			}
			if (obj.subnetMaskError != undefined) {
				subnetEl.addClass("error");
				appendErrorMessage(subnetEl.closest("div.form-group"), obj.subnetMaskError)
			}
			if (obj.dhcpRangeBeginError != undefined) {
				dhcpEl.addClass("error");
				appendErrorMessage(dhcpEl.closest("div.form-group"), obj.dhcpRangeBeginError)
			}
			if (obj.dhcpRangeEndError != undefined) {
				dhcpEndEl.addClass("error");
				appendErrorMessage(dhcpEndEl.closest("div.form-group"), obj.dhcpRangeEndError)
			}
			if (obj.dhcpServerLeaseTimeError != undefined) {
				dhcpleasetimeEl.addClass("error");
				appendErrorMessage(dhcpleasetimeEl.closest("div.form-group"), obj.dhcpServerLeaseTimeError)
			}
			if (obj.gatewayError != undefined) {
				gatewayEl.addClass("error");
				appendErrorMessage(gatewayEl.closest("div.form-group"), obj.gatewayError)
			}
		}

		function isValidMacAddress(str)
		{
			var regExPattern = /^([0-9a-fA-F]{2}[:-]){5}([0-9a-fA-F]{2})$/;
			var isValid = true;

			if (!(str.match(regExPattern)) || str.length != 17) {
				isValid = false;
			}

			return isValid;
		}

		function appendErrorMessage(el, message)
		{
			el.append('<div class="col inline_error">' + message + '</div>');
			if($("#postSuccess").is(":visible")) {
				$("#postSuccess").hide();
			}
			if($("#postFailure").is(":visible")) {
                                $("#postFailure").hide();
                        }	
			$("#globalError").addClass("notification app error");
			$("#globalError").html("<i class='icon-error'></i><tmpl_var _('webui', 'webui_save_code_failed_text')>");
			
		}

		<tmpl_if showGatewaySettings>
		toggleGatewaySettingOptions("<tmpl_var gatewaySettingValue>");

		$("#gatewaySettingOptions").on("change", function() {
			toggleGatewaySettingOptions(this.value);
		});
		</tmpl_if>
		
		<tmpl_if showIPPTInterface>
			toggleClientInterfaceOptions("<tmpl_var ipPassthroughInterface>");
		
			<tmpl_if showIPPTInterfaceOptions>	
				$("#ipPassthroughInterface").on("change", function() {
					var ethernetPortEnabled = "<tmpl_var ethernetPortEnabled>";
					if((ethernetPortEnabled === "off") && (this.value == 2 || this.value == 4)) {
						showWarning("<tmpl_var _("webui", "ippt_ethernet_off_warning_text")>");
						$("#ipPassthroughInterface").val(1);
						toggleClientInterfaceOptions(1);
					} else {
						toggleClientInterfaceOptions(this.value);
					}
					<tmpl_if showAutoPopulateClientOption>
						toggleClientInterfaceFields();
					</tmpl_if>
				});
			</tmpl_if>

			<tmpl_if showAutoPopulateClientOption>
				function toggleClientInterfaceFields() {
					if($("#ipPassthroughInterface").val() == 1) {
						$("label[for=hostIDAutoSelect]").text("<tmpl_var _("webui", "adv_lan_ip_passthrough_hostname_autoselect_label")>");
						if($("#hostIDAutoSelect").is(":checked")) {
							$("#hostNameDiv").hide();
						} else {
							$("#hostNameDiv").show();
						}
					} else {
						$("label[for=hostIDAutoSelect]").text("<tmpl_var _("webui", "adv_lan_ip_passthrough_macaddress_autoselect_label")>");
						if($("#hostIDAutoSelect").is(":checked")) {
                                                        $("#hostMACAddressDiv").hide();
                                                } else {
                                                        $("#hostMACAddressDiv").show();
                                                }
					}
				}
			</tmpl_if>
		</tmpl_if>
	});

	<tmpl_if showGatewaySettings>
	function toggleGatewaySettingOptions(state) {
		if (state == "2") {
			$("#netmaskSection").show();
			$("#gatewaySection").show();
		} else {
			$("#netmaskSection").hide();
			$("#gatewaySection").hide();
		}
	}
	</tmpl_if>

	<tmpl_if showIPPTInterface>
		function toggleClientInterfaceOptions(state) {
			if(state == "2" || state == "4") {
				var ethernetPortEnabled = "<tmpl_var ethernetPortEnabled>";
				<tmpl_if showAutoPopulateClientOption>
					if($("#hostIDAutoSelect").is(":checked")) {
						$("#hostMACAddressDiv").hide();
					} else {
						$("#hostMACAddressDiv").show();
					}
				<tmpl_else>
					$("#hostMACAddressDiv").show();
				</tmpl_if>
				$("#hostNameDiv").hide();

				if(ethernetPortEnabled === "off"){
					showWarning("<tmpl_var _("webui", "ippt_ethernet_off_warning_text")>");
				}
			} else {
				$("#hostMACAddressDiv").hide();
				<tmpl_if showAutoPopulateClientOption>
                                        if($("#hostIDAutoSelect").is(":checked")) {
                                                $("#hostNameDiv").hide();
                                        } else {
                                                $("#hostNameDiv").show();
                                        }
                                <tmpl_else>
                                        $("#hostNameDiv").show();
                                </tmpl_if>
			}
		}
	</tmpl_if>

	function showWarning(text)
	{
		modalPopup.createWindow('<tmpl_var _("webui", "ippt_ethernet_off_warning_title_text")>', '<p>'+text+'</p>', 430, "auto", [{
		text : '<tmpl_var _("webui", "webui_modal_ok_button")>', className : "primary",
		trigger : function() {
				// do nothing
                               }
		}], null, function() {
				// do nothing
		});
	}

	function checkForIPPTDisabled()
	{
		if ($("#isIpPassthroughActive").is(":checked")) {
			$("#dhcpServerEnable").prop("disabled", true);
			$("#ipAddress, #subnetMask, #macAddress, #dhcpServerEnable, #dhcpServerLeaseTime, #dhcpRangeBegin, #dhcpRangeEnd").prop("disabled", true);
			$(" #gatewaySettingOptions, #gatewaySection, #netmaskSection").prop("disabled", false);
			$("#reservedIP").prop("disabled", true);
			$(".inline_error").remove();
			$("#ipPassthroughInterface").prop("disabled", false);
			$("#hostIDAutoSelect").prop("disabled", false);
			if($("#ipPassthroughInterface").val() == 1) {
				$("#hostName").prop("disabled", false);
			} else {
				$("#hostMACAddress").prop("disabled", false);
			}
		} else {
			$(" #dhcpServerEnable").prop("disabled", false);
			$("#ipAddress, #subnetMask, #macAddress").prop("disabled", false);
			checkForDHCPDisabled();
			$(" #gatewaySettingOptions, #gatewaySection, #netmaskSection").prop("disabled", true);
			$("#hostIDAutoSelect").prop("disabled", true);
			$("#ipPassthroughInterface").prop("disabled", true);
			if($("#ipPassthroughInterface").val() == 1) {
				$("#hostName").prop("disabled", true);
			} else {
				$("#hostMACAddress").prop("disabled", true);
			}
		}
		if (jQuery.uniform) $.uniform.update()
	}

	function checkForDHCPDisabled()
	{
		if ($("#dhcpServerEnable").is(":checked")) {
			$("#dhcpServerLeaseTime").prop("disabled", false);
			$("#dhcpRangeBegin").prop("disabled", false);
			$("#dhcpRangeEnd").prop("disabled", false);
			$("#reservedIP").prop("disabled", false);
		} else {
			$("#dhcpServerLeaseTime").prop("disabled", true);
                        $("#dhcpRangeBegin").prop("disabled", true);
                        $("#dhcpRangeEnd").prop("disabled", true);
                        $("#reservedIP").prop("disabled", true);
		}
	}

	/* ]]> */
</script>

