		</div>
		<div class="form-group">
		 	<label for="xmppUserName"><tmpl_var _("webui", "tr069_xmpp_username_label")></label>
			<input type="text" name="xmppUserName" id="xmppUserName" value="<tmpl_var xmppUserName>"/>
			<div id="xmppUserNameError" <tmpl_unless xmppUserNameError> class = "inline_error" style="display:none;" </tmpl_unless> >
                		<label id="xmppUserNameErrorText"><tmpl_var xmppUserNameError></label>
			</div>
		</div>
		<div class="form-group">
			<label for="xmppPassword"><tmpl_var _("webui", "tr069_xmpp_password_label")></label>
			<input type="text" name="xmppPassword" id="xmppPassword" value="<tmpl_var xmppPassword>"/>
			<div id="xmppPasswordError" <tmpl_unless xmppPasswordError> class = "inline_error" style="display:none;" </tmpl_unless> >
                		<label id="xmppPasswordErrorText"><tmpl_var xmppPasswordError></label>
			</div>
		</div>
		<div class="form-group">
			<label for="xmppJabberID"><tmpl_var _("webui", "tr069_xmpp_jabberid_label")></label>
			<input type="text" name="xmppJabberID" id="xmppJabberID" value="<tmpl_var xmppJabberID>"/>
			<div id="xmppJabberIDError" <tmpl_unless xmppJabberIDError>  class = "inline_error" style="display:none;" </tmpl_unless> >
                		<label id="xmppJabberIDErrorText" ><tmpl_var xmppJabberIDError></label>
			</div>
		</div>
		<hr>
		<div class="form-group">
                        <div class="col label">
                                <label for="preserveStatus"><tmpl_var _("webui", "tr069_preserve_config_label")></label>
                        </div>
                        <div class="col rb">
                                <input type="radio" class="preserveStatus" name="preserveStatus" value="1" <tmpl_if IN_SET(preserveStatus, "1")>checked</tmpl_if> />
                                <label><tmpl_var _("webui", "tr069_preserve_settings_yes_text")></label>
                        </div>
                        <div class="col rb">
                                <input type="radio" class="preserveStatus" name="preserveStatus" value="0"  <tmpl_if IN_SET(preserveStatus, "0")>checked</tmpl_if> />
                                <label><tmpl_var _("webui", "tr069_preserve_settings_no_text")></label>
                        </div>
                </div>
		<div class="button_container align-field clearfix">
			<button type="submit" class="primary" id="saveButton">
				<tmpl_var _("webui", "webui_save_button")>
			</button>
			<button type="button" class="secondary" id="testButton">
				<tmpl_var _("webui", "tr069_test_custom_settings_button_text")>
			</button>
			<button type="button" class="secondary" id="viewButton">
				<tmpl_var _("webui", "tr069_view_logs_button_text")>
			</button>
		</div> 
		<div id="testButtonSuccess" class="notification app success" style="display:none;">
                        <tmpl_var _("webui", "tr069_custome_button_changes_text")>
                </div>
	</div>
</form> 

