				<td> No</td>
				<td> Yes</td>
			</tr>
			<tr>
				<td> IMAP</td>
				<td> 143</td>
				<td> Yes</td>
				<td> No</td>
				<td> Assigned</td>
			</tr>
			<tr>
				<td> IMAPS</td>
				<td> 993</td>
				<td> Yes</td>
				<td> No</td>
