		</fieldset>
	
		<fieldset class="last">
			<h3 id="WanInterfacesTitle" class="tableHeader sectionHead clearfix">
				<tmpl_var _("webui", "wan_failover_wan_interfaces_header_text")>
			</h3>
			<table id="WANInterfacesTable">
				<colgroup>
					<col class="wanType" />
					<col class="interfaceType" />
					<col class="wanStatus" />
					<col class="priority" />
					<col class="metered" />
					<col class="dataLimit" />
					<col class="cycleStartDay" />
					<col class="dataWarning" />
			        </colgroup>
				<thead>
					<tr>
						<th><tmpl_var _("webui", "wan_failover_menu_text")></th>
						<th><tmpl_var _("webui", "wan_failover_iface_type_header_text")></th>
						<th><tmpl_var _("webui", "wan_failover_status_header_text")></th>
						<th><tmpl_var _("webui", "wan_failover_priority_label_text")></th>
						<tmpl_if showDataUsageColumns>
						<th><tmpl_var _("webui", "wan_failover_metered_header_text")></th>
						<th><tmpl_var _("webui", "wan_failover_data_limit_header_text")></th>
						<th><tmpl_var _("webui", "wan_failover_cycle_start_day_header_text")></th>
						<th><tmpl_var _("webui", "wan_failover_data_warning_header_text")></th>
						</tmpl_if>
					</tr>
				</thead>
				<tbody>
					<tmpl_if WANInterfacesList>
						<tmpl_foreach WANInterfacesList as item>
							<tr class="wanInterfaceRow<tmpl_var (item.__index__ + 1)>">
								<td class="wanType">
									<tmpl_if IN_SET(item.wanType, "1")>
										<p><tmpl_var _("webui", "wan_failover_cellular_wan_label_text")></p>
									<tmpl_elsif IN_SET(item.wanType, "3")>
										<tmpl_if IN_SET(item.wanName, "eth0")>
											<p><tmpl_var _("webui", "wan_failover_ethernet1_wan_label_text")></p>
										</tmpl_if>
										<tmpl_if IN_SET(item.wanName, "eth1")>
											<p><tmpl_var _("webui", "wan_failover_ethernet0_wan_label_text")></p>
										</tmpl_if>
									<tmpl_else>
										<p><tmpl_var _("webui", "wan_failover_unknown_wan_label_text")></p>
									</tmpl_if>
								</td>
								<td class="interfaceType">
									<tmpl_if IN_SET(item.wanType, "1")>
										<p><tmpl_var _("webui", "wan_failover_wan_interface_text")></p>
									<tmpl_else>
										<select name="ifaceType<tmpl_var (item.__index__ + 1)>" id="ifaceType<tmpl_var (item.__index__ + 1)>" <tmpl_if ifaceTypeError>class="error"</tmpl_if>>
											<tmpl_include "interface_type_options.tmpl">
										</select>
										<tmpl_if ifaceTypeError>
											  <p class="error"><tmpl_var ifaceTypeError></p>
										</tmpl_if>
									</tmpl_if>
								</td>
								<td class="wanStatus">
									<p><tmpl_var item.status></p>
								</td>
								<td class="priority">
										<select name="priority<tmpl_var (item.__index__ + 1)>" id="priority<tmpl_var (item.__index__ + 1)>" <tmpl_if priorityError>class="error"</tmpl_if>>
											<tmpl_include "priority_options.tmpl">
										</select>
										<tmpl_if priorityError>
											  <p class="error"><tmpl_var priorityError></p>
										</tmpl_if>
								</td>
								<tmpl_if showDataUsageColumns>
