<tmpl_if isHidden>
	<div class="notification app error">
		<tmpl_var _("webui", "webui_app_hidden_text")>
	</div>
<tmpl_else>
	<script type="text/javascript">
		/* <![CDATA[ */

		var ifaceTypeChanged = false;
		var priorityChanged  = false;
		var isPopupExists    = false;
		var wanCount = parseInt("<tmpl_var wanCount>");
		var wanSwitchEnabled =  true;

		$(function()
		{

			 <tmpl_if IN_SET(wanSwitchEnabled, "on", "1")>
			 wanSwitchEnabled = true;
			 <tmpl_else>
			 wanSwitchEnabled = false;
			 </tmpl_if>

			checkForIfaceTypeDisabled(!wanSwitchEnabled);

			if ("<tmpl_var reboot>" === "true") {
				window.location = "<tmpl_udf GET_URI('restarting')>";
			}

			checkForMeteredDisabled();
			checkForPriorityDisabled();
			checkForDataUsageSettingsDisabled();

			for(let i=1; i<=wanCount; i++) {
				$("#metered" + i).change(checkForMeteredDisabled);

				if(! $("#ifaceType" + i).is(":hidden")) {
                                        $("#ifaceType" + i).change(checkForPriorityDisabled);
                                }
			}

			if (jQuery.fn.slideButton) {
				$("#WANSwitchingEnable").slideButton({
					change : function($input){
						if($input.is(":checked") === false ) {
							processWANSwitching($input.is(":checked"), $input);
						} else {
							processWANSwitching($input.is(":checked"), $input);
						}
					}
				});
			}

			$("#wan_failover_form").on("submit", function(e) {
				<tmpl_if WANInterfacesList>
					<tmpl_foreach WANInterfacesList as item>
						<tmpl_unless IN_SET(item.wanType, "1")>		
							var ifaceTypeEl = $("#ifaceType" + "<tmpl_var (item.__index__ + 1)>");
							if(ifaceTypeEl.val() != "<tmpl_var item.interfaceType>") {
								ifaceTypeChanged = true;
								$("#interfaceTypeChange" + "<tmpl_var (item.__index__ + 1)>").val("yes");		
							} else {
								ifaceTypeChanged = false;
								$("#interfaceTypeChange" + "<tmpl_var (item.__index__ + 1)>").val("no");
							}
						</tmpl_unless>

						var priorityEl = $("#priority" + "<tmpl_var (item.__index__ + 1)>");
						if(priorityEl.val() != "<tmpl_var item.priority>") {
							priorityChanged = true;
							$("#prioChange" + "<tmpl_var (item.__index__ + 1)>").val("yes");		
						} else {
							priorityChanged = false;
							$("#prioChange" + "<tmpl_var (item.__index__ + 1)>").val("no");
						}

						var meteredActive =  $("#metered" + "<tmpl_var (item.__index__ + 1)>").is(":checked");
						var meteredValue = "off";
						if(meteredActive) {
							meteredValue = "on";
						}

						if(meteredValue != "<tmpl_var item.metered>") {
							$("#meteredChange" + "<tmpl_var (item.__index__ + 1)>").val("yes");
						} else {
							$("#meteredChange" + "<tmpl_var (item.__index__ + 1)>").val("no");
						}

						var dataLimitEl = $("#dataLimit" + "<tmpl_var (item.__index__ + 1)>");
						$("#dataLimit_" + "<tmpl_var (item.__index__ + 1)>").val(dataLimitEl.val());
						if(dataLimitEl.val() != "<tmpl_var item.dataLimit>") {
							$("#dataLimitChange" + "<tmpl_var (item.__index__ + 1)>").val("yes");
						} else {
							$("#dataLimitChange" + "<tmpl_var (item.__index__ + 1)>").val("no");
						}
		
						var startDayEl = $("#startDay" + "<tmpl_var (item.__index__ + 1)>");
						if(startDayEl.val() != "<tmpl_var item.startDay>") {
							$("#startDayChange" + "<tmpl_var (item.__index__ + 1)>").val("yes");
						} else {
							$("#startDayChange" + "<tmpl_var (item.__index__ + 1)>").val("no");
						}

						var dataWarningEl = $("#dataWarning" + "<tmpl_var (item.__index__ + 1)>");
						$("#dataWarning_" + "<tmpl_var (item.__index__ + 1)>").val(dataWarningEl.val());
						if(dataWarningEl.val() != "<tmpl_var item.dataWarning>") {
							$("#dataWarningChange" + "<tmpl_var (item.__index__ + 1)>").val("yes");
						} else {
							$("#dataWarningChange" + "<tmpl_var (item.__index__ + 1)>").val("no");
						}						

						if(!isPopupExists && (ifaceTypeChanged || priorityChanged)) {
							e.preventDefault();
							showPopupScreen();
						}
					</tmpl_foreach>
				</tmpl_if>
			});
		});

		function showPopupScreen()
		{
			modalPopup.createWindow(
				'<tmpl_var _("webui", "webui_save_button")>',
				'<p><tmpl_var _("webui", "wan_failover_restart_popup_text")></p>',
				430, 250,
				[
					{
						text : '<tmpl_var _("webui", "webui_modal_ok_button")>',
						className : "primary",
						trigger : function() {
							$("#wan_failover_form").submit();
						}
					},
					{
						text : '<tmpl_var _("webui", "webui_modal_cancel_button")>',
						className : "cancel",
						trigger : function() {
							isPopupExists = false;
						}
					}					
				],
				function() {
					isPopupExists = true;
				},
				function() {
					isPopupExists = false;
				}
			);
		}

		function undoChange($el)
		{
			if (jQuery.fn.slideButton) $el.slideButton("undo");
		}

		function processWANSwitching(bool, $wanElem)
		{
			if (jQuery.fn.slideButton) $wanElem.slideButton("addLoader");
			var url = (bool) ? "<tmpl_udf GET_URI('wan_failover_enable_wan_switching')>" : "<tmpl_udf GET_URI('wan_failover_disable_wan_switching')>";
			$.ajax({
				url : url,
				type : "POST",
				data : {
					gSecureToken : "<tmpl_var gSecureToken>"
				},
				dataType : "json",
				success : function(data, textStatus, xhr){
					// If no network connected, success event still occurs.
					// We need to implicitly see an xhr.status greater than 0 to know we've actually
					// made contact.
					if ((xhr.readyState == 4 ) && (xhr.status == 0)) {
						undoChange($wanElem);
					}
					checkForIfaceTypeDisabled(!bool);

				},
				error : function(xhr, textStatus, errorThrown){
					undoChange($wanElem);
				},
				complete : function(xhr, textStatus){
					if (jQuery.fn.slideButton) $wanElem.slideButton("removeLoader");
					window.location.reload(true);
				}
			});
		}

		function checkForMeteredDisabled() {
			for(let i=1; i<=wanCount; i++) {
				if ($("#metered" + i).is(":checked")) {
					$("#dataLimit" + i).prop("disabled", false);
					$("#dataWarning" + i).prop("disabled", false);
				} else {
					$("#dataLimit" + i).prop("disabled", true);
					$("#dataWarning" + i).prop("disabled", true);	
				}
			}
		}

		function checkForDataUsageSettingsDisabled() {
			<tmpl_if WANInterfacesList>
                <tmpl_foreach WANInterfacesList as item>
					<tmpl_if IN_SET(item.wanType, "1")>
						<tmpl_if IN_SET(simStatusValue, SIMSTATUS_NOT_FOUND, SIMSTATUS_ERROR)>
							$("#metered"+"<tmpl_var (item.__index__ + 1)>").prop("disabled", true);
							$("#meteredChange" + "<tmpl_var (item.__index__ + 1)>").val("no");
							$("#dataLimit"+"<tmpl_var (item.__index__ + 1)>").prop("disabled", true);
							$("#dataLimitChange" + "<tmpl_var (item.__index__ + 1)>").val("no");
							$("#startDay"+"<tmpl_var (item.__index__ + 1)>").prop("disabled", true);
							$("#startDayChange" + "<tmpl_var (item.__index__ + 1)>").val("no");
							$("#dataWarnig"+"<tmpl_var (item.__index__ + 1)>").prop("disabled", true);
							$("#dataWarningChange" + "<tmpl_var (item.__index__ + 1)>").val("no");
						</tmpl_if>
						<tmpl_elsif IN_SET(item.wanType, "3")>
						<tmpl_if IN_SET(item.interfaceType, "LAN")>
							$("#metered"+"<tmpl_var (item.__index__ + 1)>").prop("disabled", true);
							$("#meteredChange" + "<tmpl_var (item.__index__ + 1)>").val("no");
							$("#dataLimit"+"<tmpl_var (item.__index__ + 1)>").prop("disabled", true);
							$("#dataLimitChange" + "<tmpl_var (item.__index__ + 1)>").val("no");
							$("#startDay"+"<tmpl_var (item.__index__ + 1)>").prop("disabled", true);
							$("#startDayChange" + "<tmpl_var (item.__index__ + 1)>").val("no");
							$("#dataWarnig"+"<tmpl_var (item.__index__ + 1)>").prop("disabled", true);
							$("#dataWarningChange" + "<tmpl_var (item.__index__ + 1)>").val("no");
						</tmpl_if>
					</tmpl_if>		
				</tmpl_foreach>
			</tmpl_if>
		}

		function checkForPriorityDisabled() {
                        for(let i=1; i<=wanCount; i++) {
                                if ($("#ifaceType" + i).val() == "WAN") {
                                        $("#priority" + i).prop("disabled", false);
                                } else {
                                        $("#priority" + i).prop("disabled", true);
                                }
                        }
                }

                function checkForIfaceTypeDisabled(bool) {
                        for(let i=1; i<=wanCount; i++) {
                           $("#ifaceType" + i).prop("disabled", bool);
                        }
                }





		/* ]]> */
	</script>

	<tmpl_if isLocked>
	    <div class="notification app error">
		<tmpl_var _("webui", "webui_app_locked_text")>
	    </div>
	</tmpl_if>

	<tmpl_if errorCount>
		<div class="notification app error">
			<div class="notification_inner">
				<p>
					<tmpl_var _("webui", "webui_save_code_failed_text")>
				</p>
			</div>
		</div>
	</tmpl_if>

	<tmpl_if gPostSuccess>
		<div class="notification app success">
			<div class="notification_inner">
				<p>
					<tmpl_var _("webui", "webui_save_code_success_text")>
				</p>
			</div>
		</div>
	</tmpl_if>

	<div class="toggleSettingContainer align-field">
		<div class="form-group">
			<label for="WANSwitchingEnable"><tmpl_var _("webui", "wan_failover_auto_wan_switch_label")></label>
			<div class="toggle">
				<input class="toggleSwitchCheckbox" type="checkbox" id="WANSwitchingEnable" name="WANSwitchingEnable"<tmpl_if IN_SET(wanSwitchEnabled, "on", "1")> checked="checked"</tmpl_if> <tmpl_if isLocked>disabled="disabled"</tmpl_if> />
			</div>
		</div>
	</div><!--/.toggleSettingContainer-->
	
	<form id="wan_failover_form" method="POST" action="<tmpl_udf GET_URI('wan_failover')>">
		<input type="hidden" name="gSecureToken" id="gSecureToken" value="<tmpl_var gSecureToken>" />
		<tmpl_if WANInterfacesList>
			<tmpl_foreach WANInterfacesList as item>
				<input type="hidden" name="wanType<tmpl_var (item.__index__ + 1)>" id="wanType<tmpl_var (item.__index__ + 1)>" value="<tmpl_var item.wanType>" />
				<tmpl_if IN_SET(item.wanType, "1")>
					<input type="hidden" name="ifaceType<tmpl_var (item.__index__ + 1)>" id="ifaceType<tmpl_var (item.__index__ + 1)>" value="<tmpl_var item.interfaceType>" />
				<tmpl_else>
					<input type="hidden" name="interfaceTypeChange<tmpl_var (item.__index__ + 1)>" id="interfaceTypeChange<tmpl_var (item.__index__ + 1)>" value="" />
				</tmpl_if>
				<tmpl_if IN_SET(item.interfaceType, "LAN")>
					<input type="hidden" name="priority_<tmpl_var (item.__index__ + 1)>" id="priority_<tmpl_var (item.__index__ + 1)>" value="<tmpl_var item.priority>" />
				</tmpl_if>
				<input type="hidden" name="wanName_<tmpl_var (item.__index__ + 1)>" id="wanName_<tmpl_var (item.__index__ + 1)>" value="<tmpl_var item.wanName>" />				
				<input type="hidden" name="wanStatus<tmpl_var (item.__index__ + 1)>" id="wanStatus<tmpl_var (item.__index__ + 1)>" value="<tmpl_var item.status>" />
				<input type="hidden" name="prioChange<tmpl_var (item.__index__ + 1)>" id="prioChange<tmpl_var (item.__index__ + 1)>" value="" />
				<input type="hidden" name="meteredChange<tmpl_var (item.__index__ + 1)>" id="meteredChange<tmpl_var (item.__index__ + 1)>" value="" />
				<input type="hidden" name="dataLimit_<tmpl_var (item.__index__ + 1)>" id="dataLimit_<tmpl_var (item.__index__ + 1)>" value="" />
				<input type="hidden" name="dataLimitChange<tmpl_var (item.__index__ + 1)>" id="dataLimitChange<tmpl_var (item.__index__ + 1)>" value="" />
				<input type="hidden" name="startDayChange<tmpl_var (item.__index__ + 1)>" id="startDayChange<tmpl_var (item.__index__ + 1)>" value="" />
				<input type="hidden" name="dataWarning_<tmpl_var (item.__index__ + 1)>" id="dataWarning_<tmpl_var (item.__index__ + 1)>" value="" />
				<input type="hidden" name="dataWarningChange<tmpl_var (item.__index__ + 1)>" id="dataWarningChange<tmpl_var (item.__index__ + 1)>" value="" />
			</tmpl_foreach>
		</tmpl_if>

		<fieldset class="first">	
			<div class="form-group form-group-lg">
				<div class="label">
                                        <label for="enableWan"> <tmpl_var _("webui", "wan_failover_enable_wan_keep_alive_label")></label>
                                </div>
				<div class="input">
                                        <input type="checkbox" name="enableWan" id="enableWan"<tmpl_if isLocked>disabled="disabled"</tmpl_if> <tmpl_if IN_SET(enableWan, "on", "1")>checked="checked"</tmpl_if> />
                                </div>
			</div>

			<div class="form-group form-group-lg">
				<div class="label">
					<label for="dnsAddress1"> <tmpl_var _("webui", "wan_failover_lookup_address1_label")></label>
				</div>
				<div class="input">
					<input type="text" name="dnsAddress1" id="dnsAddress1"<tmpl_if isLocked>disabled="disabled"</tmpl_if> value="<tmpl_var dnsAddress1>" />
				</div>
				<div class="inline_error">
					<tmpl_if dnsAddress1Error>
						<tmpl_var dnsAddress1Error>
					</tmpl_if>
				</div>
			</div>

			<div class="form-group form-group-lg">
				<div class="label">
					<label for="dnsAddress2"> <tmpl_var _("webui", "wan_failover_lookup_address2_label")></label>
				</div>
				<div class="input">
					<input type="text" name="dnsAddress2" id="dnsAddress2"<tmpl_if isLocked>disabled="disabled"</tmpl_if> value="<tmpl_var dnsAddress2>" />
				</div>
				<div class="inline_error">
					<tmpl_if dnsAddress2Error>
						<tmpl_var dnsAddress2Error>
					</tmpl_if>
				</div>
			</div>

			<div class="form-group form-group-lg">
				<div class="label">
					<label for="dnsAddress3"> <tmpl_var _("webui", "wan_failover_lookup_address3_label")></label>
				</div>
				<div class="input">
					<input type="text" name="dnsAddress3" id="dnsAddress3"<tmpl_if isLocked>disabled="disabled"</tmpl_if> value="<tmpl_var dnsAddress3>" />
				</div>
				<div class="inline_error">
					<tmpl_if dnsAddress3Error>
						<tmpl_var dnsAddress3Error>
					</tmpl_if>
				</div>
			</div>

			<div class="form-group form-group-lg">
				<div class="label">
					<label for="keepAliveInterval"> <tmpl_var _("webui", "wan_failover_keep_alive_interval_label")></label>
				</div>
				<div class="input">
					<input type="text" name="keepAliveInterval" id="keepAliveInterval"<tmpl_if isLocked>disabled="disabled"</tmpl_if> value="<tmpl_var keepAliveInterval>" />
				</div>
				<span id="keepAliveIntInfo" class="append">
					<tmpl_var _("webui", "webui_app_seconds_text")>
				</span>	
