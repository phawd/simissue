						<tmpl_var keepAliveIntervalError>
					</tmpl_if>
				</div>
			</div>

			<div class="form-group form-group-lg">
				<div class="label">
					<label for="retryAttempts"> <tmpl_var _("webui", "wan_failover_retry_attempts_label")></label>
				</div>
				<div class="input">
					<input type="text" name="retryAttempts" id="retryAttempts"<tmpl_if isLocked>disabled="disabled"</tmpl_if> value="<tmpl_var retryAttempts>" />
				</div>
				<div class="inline_error">
					<tmpl_if retryAttemptsError>
						<tmpl_var retryAttemptsError>
					</tmpl_if>
				</div>
			</div>

			<div class="form-group form-group-lg">
				<div class="label">
					<label for="retryInterval"> <tmpl_var _("webui", "wan_failover_retry_interval_label")></label>
				</div>
				<div class="input">
					<input type="text" name="retryInterval" id="retryInterval"<tmpl_if isLocked>disabled="disabled"</tmpl_if> value="<tmpl_var retryInterval>" />
				</div>
				<span id="retryIntInfo" class="append">
                                        <tmpl_var _("webui", "webui_app_seconds_text")>
                                </span>
				<div class="inline_error">
