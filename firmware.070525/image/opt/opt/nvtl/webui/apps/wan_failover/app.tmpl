			</tmpl_if>

		</fieldset>

		<fieldset>
			<h3 id="WanSwitchingRulesTitle" class="table_header sectionHead clearfix">
				<tmpl_var _("webui", "wan_failover_switching_rules_header_text")>
			</h3>
			<table id="WanRulesTable">
				<colgroup>
					<col class="wanRule" />
					<col class="wanActive" />
