									<input type="checkbox" name="metered<tmpl_var (item.__index__ + 1)>" id="metered<tmpl_var (item.__index__ + 1)>" <tmpl_if IN_SET(item.metered, "on", "1")>checked="checked"</tmpl_if> />
								</td>
								<td class="dataLimit">
									<input type="text" name="dataLimit<tmpl_var (item.__index__ + 1)>" id="dataLimit<tmpl_var (item.__index__ + 1)>" maxlength="5" size="5" value="<tmpl_var item.dataLimit>" <tmpl_if dataLimitError>class="error"</tmpl_if> />
									<span id="dataLimitInfo" class="append">
										<tmpl_var _("webui", "webui_app_gigabytes_text")>
									</span>
									<tmpl_if dataLimitError>
                                          <p class="error"><tmpl_var dataLimitError></p>
                                    </tmpl_if>
								</td>
								<td class="cycleStartDay">
									<select name="startDay<tmpl_var (item.__index__ + 1)>" id="startDay<tmpl_var (item.__index__ + 1)>">
										<tmpl_include "usage_plan_start_day_options.tmpl">
									</select>
								</td>
								<td class="dataWarning">
									<input type="text" name="dataWarning<tmpl_var (item.__index__ + 1)>" id="dataWarning<tmpl_var (item.__index__ + 1)>" maxlength="5" size="5" value="<tmpl_var item.dataWarning>" <tmpl_if dataWarningError>class="error"</tmpl_if> />
									<span id="dataWarningInfo" class="append">
                                         <tmpl_var _("webui", "webui_percentage_symbol")>
                                    </span>
									<tmpl_if dataWarningError>
										<p class="error"><tmpl_var dataWarningError></p>
									</tmpl_if>
								</td>
								</tmpl_if>
							</tr>
						</tmpl_foreach>
					</tmpl_if>
				</tbody>
			</table>
		</fieldset>

		<div class="button_container align-field clearfix">
			<button type="submit" class="primary" id="saveWANInfo">
				<tmpl_var _("webui", "webui_save_button")>
