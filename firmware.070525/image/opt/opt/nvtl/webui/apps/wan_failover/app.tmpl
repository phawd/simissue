				</colgroup>
				<thead>
					<tr>
						<th><tmpl_var _("webui", "wan_failover_rule_header_text")></th>
                                                <th><tmpl_var _("webui", "wan_failover_active_header_text")></th>
                                                <th><tmpl_var _("webui", "wan_failover_priority_label_text")></th>
					</tr>
				</thead>
				<tbody>
					<td class="wanType">
                                        	<p><tmpl_var _("webui", "wan_failover_connectivity_testing_label_text")></p>
                                        </td>
