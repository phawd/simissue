					}	
				}

				if(typeof obj.statusData.statusBarVpnConnectDisconnectButtonText !== "undefined") {
					$("#vpnConnectDisconnect").html(obj.statusData.statusBarVpnConnectDisconnectButtonText);
				} 

				if(typeof obj.statusData.statusBarVpnShowConnectButton !== "undefined") {
					$("#vpnConnectDisconnect").prop("disabled", !obj.statusData.statusBarVpnShowConnectButton);
				}

				if(typeof obj.statusData.statusBarVpnAutoConnectEnabled !== "undefined") {
					if (jQuery.fn.slideButton) {
	            				$("#autoConnectEnabled").slideButton("disable", false);
	            			}	
				}

				if(typeof obj.statusData.statusBarVpnShowLogButton !== "undefined") {
					$("#viewLog").prop( "disabled", !obj.statusData.statusBarVpnShowLogButton);
				}

				if(obj.statusData.statusBarVpnConnectionState == "<tmpl_var _('webui', 'vpn_connected_text')>") {
					$("#vpnConnectionTime").show().html(obj.statusData.statusBarVpnConnectedDays + "<tmpl_var _('webui', 'vpn_connection_days_text')>"+ obj.statusData.statusBarVpnConnectedHours+ "<tmpl_var _('webui', 'vpn_connection_hours_text')>" + obj.statusData.statusBarVpnConnectedMinutes +"<tmpl_var _('webui', 'vpn_connection_minutes_text')>" + obj.statusData.statusBarVpnConnectedSeconds + "<tmpl_var _('webui', 'vpn_connection_seconds_text')>");
					$("#editVpnSettings").prop( "disabled", true);
				} else {
					$("#vpnConnectionTime").html("");
					$("#editVpnSettings").prop( "disabled", false);
				}
			} catch(e) {}
		}
