							successWindow();
							connectStatusPopup =  false;
						} else {
							if(((obj.statusData.statusBarVpnConnectionState == "<tmpl_var _('webui', 'vpn_no_internet_access_error_text')>") ||
							    (obj.statusData.statusBarVpnConnectionState == "<tmpl_var _('webui', 'vpn_server_unreachable_error_text')>")  ||
							    (obj.statusData.statusBarVpnConnectionState == "<tmpl_var _('webui', 'vpn_authentication_failure_error_text')>") ||
							    (obj.statusData.statusBarVpnConnectionState == "<tmpl_var _('webui', 'vpn_certificate_error_text')>") ||
							    (obj.statusData.statusBarVpnConnectionState == "<tmpl_var _('webui', 'vpn_key_file_error_text')>") ||
