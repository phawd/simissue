				if(typeof obj.statusData.statusBarVpnConnectionState !== "undefined") {
					if(obj.statusData.statusBarVpnConnectionState == "<tmpl_var _('webui', 'vpn_checking_vpn_connection')>") {
						$("#connectionState").hide();
					} else {
